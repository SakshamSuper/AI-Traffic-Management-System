# Same as .env but for reference
APP_NAME=AI Traffic Management System
VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+asyncpg://traffic_user:traffic_pass@postgres:5432/traffic_db
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000","http://localhost","http://frontend:3000"]
AI_MODEL_PATH=models/yolo11n.pt
AI_CONFIDENCE_THRESHOLD=0.5
AI_NMS_THRESHOLD=0.45
MAX_CAMERAS=20
FRAME_RATE=10
STREAM_QUALITY=medium
LOG_LEVEL=INFO
ENVIRONMENT=development
